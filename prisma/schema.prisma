generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// TENANTS
// Every business record belongs to exactly one tenant (company).
// ═══════════════════════════════════════════

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique // company code typed at login, e.g. "mbuyu"
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prefix for shipment tracking numbers (e.g. "MBCFL" → MBCFL-2026-00001).
  // Unique so tracking numbers stay globally unique for public tracking.
  trackingPrefix String @unique

  // Branding used on emails and quote PDFs
  tagline      String?
  contactEmail String?
  contactPhone String?
  website      String?
  address      String?

  users             User[]
  quotes            Quote[]
  shipments         Shipment[]
  shipmentEvents    ShipmentEvent[]
  shipmentDocuments ShipmentDocument[]
  vehicles          Vehicle[]
  checklists        Checklist[]
  maintenance       MaintenanceTicket[]
  journeys          Journey[]
  journeyEvents     JourneyEvent[]
  transfers         ShipmentTransfer[]
}

// ═══════════════════════════════════════════
// USERS
// ═══════════════════════════════════════════

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN // platform owner — manages tenants
}

enum StaffRole {
  HEAD_OFFICE
  DRIVER
  OPERATIONS
}

model User {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  email     String
  password  String
  name      String
  phone     String?
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffRole StaffRole?

  // Customer compliance fields
  companyName           String?
  tinNumber             String?
  ninNumber             String?
  passportNumber        String?
  address               String?
  city                  String?
  country               String?
  registrationCompleted Boolean @default(true)
  documentUrl           String?

  // Relations
  shipmentsAsCustomer Shipment[]         @relation("CustomerShipments")
  shipmentsAsStaff    Shipment[]         @relation("StaffShipments")
  eventsCreated       ShipmentEvent[]    @relation("EventCreatedBy")
  documentsUploaded   ShipmentDocument[] @relation("DocumentUploadedBy")

  checklistsAsDriver   Checklist[]         @relation("DriverChecklists")
  journeysAsDriver     Journey[]           @relation("DriverJourneys")
  maintenanceAssigned  MaintenanceTicket[] @relation("MaintenanceAssigned")
  maintenanceStarted   MaintenanceTicket[] @relation("MaintenanceStarted")
  journeyEventsCreated JourneyEvent[]      @relation("JourneyEventCreator")

  quotesAsCustomer Quote[] @relation("CustomerQuotes")

  transfersInitiated   ShipmentTransfer[] @relation("TransferInitiatedBy")
  transfersAsOldDriver ShipmentTransfer[] @relation("TransferOldDriver")
  transfersAsNewDriver ShipmentTransfer[] @relation("TransferNewDriver")

  @@unique([tenantId, email])
  @@index([email])
  @@index([role])
  @@index([staffRole])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
// QUOTES
// ═══════════════════════════════════════════

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  REJECTED
}

model Quote {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reference String      @unique @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  status    QuoteStatus @default(NEW)

  fullName         String
  companyName      String?
  email            String
  phone            String
  preferredContact String

  cargoType          String
  transportMode      String
  weightKg           String
  volumeCbm          String?
  pieces             String
  cargoDescription   String
  cargoValue         String?
  cargoValueCurrency String?

  originCountry      String
  originCity         String
  destinationCountry String
  destinationCity    String
  shippingDate       String
  incoterms          String

  specialRequirements String?
  hasDocuments        Boolean @default(false)

  quotedAmount   String?
  quotedCurrency String?
  adminResponse  String?
  respondedAt    DateTime?

  taxName    String?
  taxRate    String?
  taxAmount  String?
  // null = admin hasn't decided yet (UI falls back to the destination's tax rule)
  taxEnabled Boolean?

  shipmentId String?   @unique
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  inviteToken       String?   @unique
  inviteTokenSentAt DateTime?
  inviteUsedAt      DateTime?

  customerId String?
  customer   User?   @relation("CustomerQuotes", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([inviteToken])
  @@index([customerId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
// SHIPMENTS
// ═══════════════════════════════════════════

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  AT_CUSTOMS
  CUSTOMS_HOLD
  CUSTOMS_CLEARED
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

model Shipment {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  trackingNumber String  @unique
  reference      String?

  customerId    String?
  customer      User?   @relation("CustomerShipments", fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String
  customerPhone String

  assignedToId String?
  assignedTo   User?   @relation("StaffShipments", fields: [assignedToId], references: [id], onDelete: SetNull)

  description String
  cargoType   String
  weightKg    String
  volumeCbm   String?
  pieces      String

  originCountry      String
  originCity         String
  destinationCountry String
  destinationCity    String

  status ShipmentStatus @default(PENDING)

  events    ShipmentEvent[]
  documents ShipmentDocument[]
  quote     Quote?
  journeys  Journey[]

  transfers ShipmentTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingNumber])
  @@index([status])
  @@index([customerId])
  @@index([customerEmail])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([tenantId])
}

model ShipmentEvent {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status   ShipmentStatus
  location String
  note     String?

  createdById String?
  createdBy   User?   @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([createdAt])
  @@index([tenantId])
}

model ShipmentDocument {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String
  fileSize Int
  mimeType String

  uploadedById String?
  uploadedBy   User?   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
// FLEET
// ═══════════════════════════════════════════

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  OUT_OF_SERVICE
}

model Vehicle {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  plate    String
  type     String
  capacity String?
  status   VehicleStatus @default(AVAILABLE)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklists Checklist[]
  journeys   Journey[]

  @@unique([tenantId, plate])
  @@index([plate])
  @@index([status])
  @@index([tenantId])
}

enum ChecklistStatus {
  SUBMITTED
  FLAGGED
  UNDER_REPAIR
  CLEARED
  APPROVED
}

model Checklist {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  driverId String
  driver   User   @relation("DriverChecklists", fields: [driverId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  driverName         String
  driverPermitNo     String
  driverPermitClass  String
  driverPermitExpiry DateTime

  oilOk     Boolean
  waterOk   Boolean
  tyresOk   Boolean
  brakesOk  Boolean
  engineOk  Boolean
  lightsOk  Boolean
  hornOk    Boolean
  mirrorsOk Boolean
  bodyOk    Boolean

  issuesNotes String?

  status ChecklistStatus @default(SUBMITTED)

  maintenanceTickets MaintenanceTicket[]
  journey            Journey?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model MaintenanceTicket {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  issue  String
  status MaintenanceStatus @default(OPEN)

  assignedToId String?
  assignedTo   User?   @relation("MaintenanceAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)

  startedById String?
  startedBy   User?     @relation("MaintenanceStarted", fields: [startedById], references: [id], onDelete: SetNull)
  startedAt   DateTime?

  photoBefore        String?
  photoBeforeTakenAt DateTime?

  photoAfter        String?
  photoAfterTakenAt DateTime?

  resolutionNote String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedToId])
  @@index([checklistId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
// JOURNEYS
// ═══════════════════════════════════════════

enum JourneyStatus {
  NOT_STARTED
  IN_TRANSIT
  COMPLETED
  ABORTED
  TRANSFERRED
}

model Journey {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  driverId String
  driver   User   @relation("DriverJourneys", fields: [driverId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  checklistId String?    @unique
  checklist   Checklist? @relation(fields: [checklistId], references: [id], onDelete: SetNull)

  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  status   JourneyStatus @default(NOT_STARTED)
  isPaused Boolean       @default(false)

  startedAt   DateTime?
  completedAt DateTime?

  // Transfer chain: which journey did this one come from, and where did it go
  transferredFromId String?  @unique
  transferredFrom   Journey? @relation("JourneyTransferChain", fields: [transferredFromId], references: [id], onDelete: SetNull)
  transferredTo     Journey? @relation("JourneyTransferChain")

  events JourneyEvent[]

  // Audit records for this journey's transfers
  transfersAsOld ShipmentTransfer[] @relation("TransferOldJourney")
  transfersAsNew ShipmentTransfer[] @relation("TransferNewJourney")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([shipmentId])
  @@index([createdAt])
  @@index([isPaused])
  @@index([tenantId])
}

model JourneyEvent {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  // STARTED | CHECKPOINT | STOP | INCIDENT | UPDATE | RESUMED | ENDED | TRANSFERRED
  type String

  lat Float
  lng Float

  locationName String?
  note         String?

  createdById String
  createdBy   User   @relation("JourneyEventCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([journeyId])
  @@index([createdAt])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
// SHIPMENT TRANSFERS (NEW)
// ═══════════════════════════════════════════

enum TransferReason {
  BREAKDOWN
  ACCIDENT
  SECURITY_INCIDENT
  DRIVER_FATIGUE
  DRIVER_UNAVAILABLE
  ROUTE_BLOCKED
  OTHER
}

enum CargoCondition {
  INTACT
  PARTIALLY_DAMAGED
  MISSING_ITEMS
  MAJOR_DAMAGE
  UNKNOWN
}

model ShipmentTransfer {
  id       String @id @default(cuid())
  // Filled in by the Prisma tenant extension (lib/prisma.ts). The DB default
  // resolves to NULL, so an insert that bypasses the extension fails loudly.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  oldJourneyId String
  oldJourney   Journey @relation("TransferOldJourney", fields: [oldJourneyId], references: [id], onDelete: Cascade)

  newJourneyId String?
  newJourney   Journey? @relation("TransferNewJourney", fields: [newJourneyId], references: [id], onDelete: SetNull)

  // Who did the transfer
  initiatedById String
  initiatedBy   User   @relation("TransferInitiatedBy", fields: [initiatedById], references: [id])

  oldDriverId String
  oldDriver   User   @relation("TransferOldDriver", fields: [oldDriverId], references: [id])

  newDriverId String
  newDriver   User   @relation("TransferNewDriver", fields: [newDriverId], references: [id])

  newVehicleId String

  // Details
  reason     TransferReason
  reasonNote String?

  // Cargo condition at handoff
  cargoCondition CargoCondition @default(UNKNOWN)
  cargoNotes     String?
  missingItems   String?
  damageNotes    String?

  // Photos (JSON-encoded array of URLs)
  photoUrls String?

  // Where
  lat          Float
  lng          Float
  locationName String?

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([oldJourneyId])
  @@index([newJourneyId])
  @@index([newDriverId])
  @@index([createdAt])
  @@index([tenantId])
}
